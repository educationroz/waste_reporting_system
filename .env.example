# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. The settings fail loudly at startup if SECRET_KEY is
# missing, so a fresh clone must create .env before running any command.
# ---------------------------------------------------------------------------

# REQUIRED. Any random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=change-me-to-a-random-secret

# Development = True (needed to serve static/media via the dev server).
# Production = False (enables HSTS, HTTPS redirect and Secure cookies).
DEBUG=True

# Comma-separated hosts this site answers to.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# sqlite3 for development, postgresql for production.
# If production forgets to set this, the app refuses to start (by design).
DB_ENGINE=sqlite3
DB_NAME=waste_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=600

# Redis for caching + the WebSocket channel layer.
# REQUIRED in production: the app refuses to start with USE_REDIS=false when
# DEBUG=False, because a per-worker in-memory cache/channel layer silently
# breaks multi-worker deployments. Development may leave it false (uses
# LocMemCache + in-memory channel layer, fine for one process).
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Optional Google Sign-In (empty disables the login button).
GOOGLE_OAUTH_CLIENT_ID=

# CSP rollout: compat (safe) -> report (measure) -> strict (enforce).
CSP_MODE=compat
# Optional CSP violation report-uri / report-to endpoint.
CSP_REPORT_URI=

# Email. Production must switch away from the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
# Gate the DNS/MX deliverability check on registration (defaults to on when
# DEBUG=False, off when DEBUG=True).
EMAIL_CHECK_DELIVERABILITY=False

# Media storage backend: 'local' (default, FileSystemStorage) or 's3' for
# horizontal scaling + CDN edge. When 's3', AWS_STORAGE_BUCKET_NAME is
# required (fail-loud in production).
MEDIA_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Only needed for non-AWS S3-compatible storage (MinIO, Backblaze, ...).
AWS_S3_ENDPOINT_URL=

# Optional error tracking. Leave empty to disable; set a Sentry DSN to start
# sending unhandled exceptions + error-level logs.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ML classification runs on a background thread pool so uploads don't block.
# ML_MAX_WORKERS=0 runs it synchronously (old behaviour).
ML_MAX_WORKERS=2
ML_FAST_PATH_TIMEOUT=1.5
# Emails (verification, password reset, notifications) are sent on a small
# dedicated background pool so SMTP latency never blocks a request.
EMAIL_MAX_WORKERS=2