# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. The settings fail loudly at startup if SECRET_KEY is
# missing, so a fresh clone must create .env before running any command.
# ---------------------------------------------------------------------------

# REQUIRED. Any random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=change-me-to-a-random-secret

# Development = True (needed to serve static/media via the dev server).
# Production = False (enables HSTS, HTTPS redirect and Secure cookies).
DEBUG=True

# Comma-separated hosts this site answers to.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# sqlite3 for development, postgresql for production.
# If production forgets to set this, the app refuses to start (by design).
DB_ENGINE=sqlite3
DB_NAME=waste_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=600

# Redis for caching + the WebSocket channel layer.
# REQUIRED in production: the app refuses to start with USE_REDIS=false when
# DEBUG=False, because a per-worker in-memory cache/channel layer silently
# breaks multi-worker deployments. Development may leave it false (uses
# LocMemCache + in-memory channel layer, fine for one process).
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Optional Google Sign-In (empty disables the login button).
GOOGLE_OAUTH_CLIENT_ID=

# CSP rollout: compat (safe) -> report (measure) -> strict (enforce).
CSP_MODE=compat
# Optional CSP violation report-uri / report-to endpoint.
CSP_REPORT_URI=

# ─── EMAIL ────────────────────────────────────────────────────────────────────
# Choose ONE backend:
#   A) Gmail SMTP (local dev only — Railway/Render/Fly block outbound SMTP):
#      EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#      EMAIL_HOST=smtp.gmail.com
#      EMAIL_PORT=587
#      EMAIL_USE_TLS=True
#      EMAIL_HOST_USER=safhasaharinfo@gmail.com
#      EMAIL_HOST_PASSWORD=<16-char Gmail App Password>
#      DEFAULT_FROM_EMAIL=SafhaSahar <safhasaharinfo@gmail.com>
#
#   B) Resend HTTP API (RECOMMENDED for production on Railway — no SMTP needed):
#      RESEND_API_KEY=re_xxxxxxxxxxxxx
#      DEFAULT_FROM_EMAIL=SafhaSahar <noreply@safhasahar.com>  # must use YOUR verified domain in Resend
#      CONTACT_FORM_RECIPIENT=safhasaharinfo@gmail.com  # where contact form emails go
#      # EMAIL_BACKEND auto-switches to api_app.email_backends.ResendEmailBackend
RESEND_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=safhasaharinfo@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SafhaSahar <safhasaharinfo@gmail.com>
CONTACT_FORM_RECIPIENT=safhasaharinfo@gmail.com
# Gate the DNS/MX deliverability check on registration (defaults to on when
# DEBUG=False, off when DEBUG=True).
EMAIL_CHECK_DELIVERABILITY=False

# Media storage backend: 'local' (default, FileSystemStorage), 's3' for
# horizontal scaling + CDN edge, or 'cloudinary' to serve every photo/PDF from
# the Cloudinary CDN over https (works on every device/role, survives
# container restarts). When 'cloudinary', the CLOUDINARY_* credentials below
# are required. When 's3', AWS_STORAGE_BUCKET_NAME is required (fail-loud in
# production).
MEDIA_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Only needed for non-AWS S3-compatible storage (MinIO, Backblaze, ...).
AWS_S3_ENDPOINT_URL=

# Cloudinary CDN media storage (only used when MEDIA_BACKEND=cloudinary).
# Get these from https://console.cloudinary.com -> Dashboard and Settings ->
# Account -> API Keys ("Create API Key").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional error tracking. Leave empty to disable; set a Sentry DSN to start
# sending unhandled exceptions + error-level logs.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ML classification runs on a background thread pool so uploads don't block.
# ML_MAX_WORKERS=0 runs it synchronously (old behaviour).
ML_MAX_WORKERS=2
ML_FAST_PATH_TIMEOUT=1.5
# Emails (verification, password reset, notifications) are sent on a small
# dedicated background pool so SMTP latency never blocks a request.
EMAIL_MAX_WORKERS=2

# ---------------------------------------------------------------------------
# WebSocket abuse limits (Channels). All have safe defaults; override only if
# you are behind a proxy that multiplexes many clients onto one IP.
# ---------------------------------------------------------------------------
# Concurrent sockets allowed per authenticated user. Each socket is one
# channel-layer consumer, so this bounds per-user memory.
WS_MAX_CONNECTIONS_PER_USER=5
# Inbound frames a single socket may send per window before it is closed
# with code 4009.
WS_MAX_MESSAGES_PER_WINDOW=60
WS_MESSAGE_WINDOW_SECONDS=10
# Anonymous/adopted handshakes per IP per window, enforced BEFORE the session
# lookup so a flood cannot be used to hammer the database.
WS_MAX_HANDSHAKES_PER_WINDOW=30
WS_HANDSHAKE_WINDOW_SECONDS=60
# Set true to exempt is_staff users from the handshake-rate check.
WS_EXEMPT_STAFF=False

# ---------------------------------------------------------------------------
# Health probes. /healthz and /readyz are unauthenticated, so the detailed
# per-check breakdown is OFF by default - it would otherwise leak component
# names and dependency state to anyone who can reach the port.
# HEALTHCHECK_TIMEOUT is the per-check budget in seconds; keep it well under
# the orchestrator's own probe timeout (see railway.json).
# ---------------------------------------------------------------------------
HEALTHCHECK_TIMEOUT=2.0
HEALTHCHECK_DETAIL=False

# Logging. LOG_LEVEL applies to the app's own loggers (django.request, api_app,
# notif_debug, backup); the console handler is always used. LOG_FILE adds an
# extra on-host file handler for platforms that lose stdout - leave empty to
# rely on the platform log drain.
LOG_LEVEL=
LOG_FILE=

# Extra origins allowed to make cross-origin API calls, in addition to the
# hosts in ALLOWED_HOSTS. Comma-separated; leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# Query-string auth for private S3 objects. Leave false unless your CDN
# requires presigned URLs.
AWS_QUERYSTRING_AUTH=False

# ---------------------------------------------------------------------------
# Web push (service worker notifications). Disabled until a VAPID keypair is
# configured - generate one with:
#   python manage.py generate_vapid_keys
# WEB_PUSH_ENABLED stays false while the keys are empty, so pushing is inert
# rather than erroring.
# ---------------------------------------------------------------------------
WEB_PUSH_ENABLED=False
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=noreply@wastesystem.local

# ---------------------------------------------------------------------------
# Used only by the manual SMTP smoke-test script (test_email.py), not by the
# app. Fill these in to run that script against a real Gmail app password.
# ---------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=