# Copy this file to .env for local development. Never commit the copied file.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Values below are deliberately non-sensitive examples, not usable credentials.

# Django
DEBUG=True
SECRET_KEY=replace-with-a-unique-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,0.0.0.0,.e2b.app

# Database: SQLite is the default. Set DB_ENGINE=postgresql to use PostgreSQL.
DB_ENGINE=sqlite3
# DB_NAME=waste_db
# DB_USER=waste_app
# DB_PASSWORD=replace-with-a-unique-database-password
# DB_HOST=localhost
# DB_PORT=5432

# Optional Google Sign-In. A client ID is public by design; never place a
# Google OAuth client secret in browser code or this repository.
GOOGLE_OAUTH_CLIENT_ID=

# Email: development defaults to the console backend and needs no credentials.
# To send through Gmail, create an app password and keep it only in your secret
# manager or local .env file.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=replace-with-a-gmail-app-password
# DEFAULT_FROM_EMAIL=noreply@example.com

# Production hardening
# CSP_MODE=strict
# HEALTHCHECK_DETAIL=False
