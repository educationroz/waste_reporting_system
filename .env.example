# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. The settings fail loudly at startup if SECRET_KEY is
# missing, so a fresh clone must create .env before running any command.
# ---------------------------------------------------------------------------

# REQUIRED. Any random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=change-me-to-a-random-secret

# Development = True (needed to serve static/media via the dev server).
# Production = False (enables HSTS, HTTPS redirect and Secure cookies).
DEBUG=True

# Comma-separated hosts this site answers to.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# sqlite3 for development, postgresql for production.
# If production forgets to set this, the app refuses to start (by design).
DB_ENGINE=sqlite3
DB_NAME=waste_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=600

# Optional Redis for caching + the WebSocket channel layer. Set True in
# production when Redis is running (required for multi-worker deployments).
USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional Google Sign-In (empty disables the login button).
GOOGLE_OAUTH_CLIENT_ID=

# CSP rollout: compat (safe) -> report (measure) -> strict (enforce).
CSP_MODE=compat
# Optional CSP violation report-uri / report-to endpoint.
CSP_REPORT_URI=

# Email. Production must switch away from the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
# Gate the DNS/MX deliverability check on registration (defaults to on when
# DEBUG=False, off when DEBUG=True).
EMAIL_CHECK_DELIVERABILITY=False